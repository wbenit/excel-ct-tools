<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 设置目标框架为 .NET Framework 4.8 以保证最广 Excel 兼容性 -->
    <TargetFramework>net48</TargetFramework>
    <!-- 指定生成动态链接库 assemblies -->
    <OutputType>Library</OutputType>
    <!-- 设置 C# 语言版本支持 Nullable 与最新语法特性 -->
    <LangVersion>10.0</LangVersion>
    <!-- 设置生成的程序集文件名称 -->
    <AssemblyName>ExcelAddInDemo</AssemblyName>
    <!-- 开启隐式全局引用 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 开启空值警告检查 -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引入 Microsoft.CSharp 以支持 dynamic 绑定 Excel COM 对象 -->
    <Reference Include="Microsoft.CSharp" />
    <!-- 引入 System.Windows.Forms 支持窗体与 WebView2 宿主容器 -->
    <Reference Include="System.Windows.Forms" />
    <!-- 引入 System.Drawing 支持窗体与界面绘制 -->
    <Reference Include="System.Drawing" />
    <!-- 引入 Excel-DNA 核心整合包，用于支持 C# 与 Excel COM 及函数交互 -->
    <PackageReference Include="ExcelDna.Integration" Version="1.6.0" />
    <!-- 引入 Excel-DNA 自动构建打包工具，构建时会自动生成 .xll 文件 -->
    <PackageReference Include="ExcelDna.AddIn" Version="1.6.0" />
    <!-- 引入 WebView2 组件包用于支持 Vue 3 现代界面 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- 引入 System.Text.Json 依赖包用于 net48 下的 JSON 序列化 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自动将前端 Vue 3 登录与配置页面复制至构建输出路径中 -->
    <None Include="Resources\login.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
