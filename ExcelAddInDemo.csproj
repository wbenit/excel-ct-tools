<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 设置目标框架为 .NET Framework 4.8 以保证最广 Excel 兼容性 -->
    <TargetFramework>net48</TargetFramework>
    <!-- 指定生成动态链接库 assemblies -->
    <OutputType>Library</OutputType>
    <!-- 设置 C# 语言版本支持 Nullable 与最新语法特性 -->
    <LangVersion>10.0</LangVersion>
    <!-- 设置生成的程序集文件名称 -->
    <AssemblyName>ExcelAddInDemo</AssemblyName>
    <!-- 开启隐式全局引用 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 开启空值警告检查 -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引入 Microsoft.CSharp 以支持 dynamic 绑定 Excel COM 对象 -->
    <Reference Include="Microsoft.CSharp" />
    <!-- 引入 System.Windows.Forms 支持窗体与 WebView2 宿主容器 -->
    <Reference Include="System.Windows.Forms" />
    <!-- 引入 System.Drawing 支持窗体与界面绘制 -->
    <Reference Include="System.Drawing" />
    <!-- 引入 Excel-DNA 核心整合包，用于支持 C# 与 Excel COM 及函数交互 -->
    <PackageReference Include="ExcelDna.Integration" Version="1.6.0" />
    <!-- 引入 Microsoft.Office.Interop.Excel 强类型 COM 支持包 -->
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001" />
    <!-- 引入 Excel-DNA 自动构建打包工具，构建时会自动生成 .xll 文件 -->
    <PackageReference Include="ExcelDna.AddIn" Version="1.6.0" />
    <!-- 引入 WebView2 组件包用于支持 Vue 3 现代界面 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- 引入 System.Text.Json 依赖包用于 net48 下的 JSON 序列化 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自动将前端 Vue 3 登录与配置页面复制至构建输出路径中 -->
    <None Include="Resources\login.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 自动将企业设置前端 Vue 3 页面复制至构建输出路径中 -->
    <None Include="Resources\enterprise_settings.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 自动将新建项目前端 Vue 3 页面复制至构建输出路径中 -->
    <None Include="Resources\create_project.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 自动将公式法调费前端 Vue 3 页面复制至构建输出路径中 -->
    <None Include="Resources\formula_adjust_fee.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 自动将箱柜模板 Excel 文件复制至构建输出路径中 -->
    <None Include="Resources\CabinetTemplate.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 自动将 JSON 配置文件复制至构建输出路径中 -->
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 自动将项目依赖 DLL 以及 WebView2 原生 runtimes 文件和 Resources 发布至 publish 目录 -->
  <Target Name="CopyDependenciesToPublish" AfterTargets="ExcelDnaPack">
    <ItemGroup>
      <!-- 获取输出路径中的所有 DLL 程序集 -->
      <PublishDependencies Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetFileName)" />
      <!-- 获取原生 WebView2 runtimes 架构动态链接库文件 -->
      <RuntimeFiles Include="$(TargetDir)runtimes\**\*.*" />
      <!-- 获取 Resources 前端 HTML 资源文件 -->
      <ResourceFiles Include="$(TargetDir)Resources\**\*.*" />
      <!-- 获取 appsettings.json 配置文件 -->
      <ConfigFile Include="$(TargetDir)appsettings.json" />
    </ItemGroup>
    <!-- 自动复制依赖 DLL 至 publish 发布目录 -->
    <Copy SourceFiles="@(PublishDependencies)" DestinationFolder="$(TargetDir)publish\" SkipUnchangedFiles="true" />
    <!-- 自动复制 runtimes 目录至 publish 发布目录 -->
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFolder="$(TargetDir)publish\runtimes\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- 自动复制 Resources 资源目录至 publish 发布目录 -->
    <Copy SourceFiles="@(ResourceFiles)" DestinationFolder="$(TargetDir)publish\Resources\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- 自动复制 appsettings.json 配置文件至 publish 发布目录 -->
    <Copy SourceFiles="@(ConfigFile)" DestinationFolder="$(TargetDir)publish\" SkipUnchangedFiles="true" />
  </Target>

</Project>
