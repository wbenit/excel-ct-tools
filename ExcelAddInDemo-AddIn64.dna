<?xml version="1.0" encoding="utf-8"?>
<DnaLibrary Name="ExcelAddInDemo Add-In64" RuntimeVersion="v4.0" xmlns="http://schemas.excel-dna.net/addin/2020/07/dnalibrary">
  <!-- 主程序集 ExternalLibrary 定义 -->
  <ExternalLibrary Path="ExcelAddInDemo.dll" ExplicitExports="false" LoadFromBytes="true" Pack="true" IncludePdb="false" />

  <!-- 强制指示 ExcelDnaPack 将所有依赖的第三方 DLL 打包压入 -packed.xll 中 -->
  <Reference Path="Microsoft.Web.WebView2.WinForms.dll" Pack="true" />
  <Reference Path="Microsoft.Web.WebView2.Core.dll" Pack="true" />
  <Reference Path="System.Text.Json.dll" Pack="true" />
  <Reference Path="Microsoft.Bcl.AsyncInterfaces.dll" Pack="true" />
  <Reference Path="System.Text.Encodings.Web.dll" Pack="true" />
  <Reference Path="System.Memory.dll" Pack="true" />
  <Reference Path="System.Buffers.dll" Pack="true" />
  <Reference Path="System.ValueTuple.dll" Pack="true" />
</DnaLibrary>
